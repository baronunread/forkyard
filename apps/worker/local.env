# Local development only: `wrangler dev --env-file local.env` (bun run dev) loads this file;
# production never sees it. These are emulator credentials and a throwaway secret, not real ones:
# sign-in runs against emulate.dev, seeded from emulate.config.yaml.

# Short settle time so the autopilot is visible in a local demo (default 15 s).
AUTOPILOT_QUIET_MS=4000
FORKYARD_DEV=true
BETTER_AUTH_SECRET=local-dev-secret-not-for-production-0123456789
# scripts/dev.ts overrides these with the portless URLs.
EMULATE_GITHUB_URL=http://localhost:4001
EMULATE_GOOGLE_URL=http://localhost:4002
GITHUB_CLIENT_ID=forkyard-local
GITHUB_CLIENT_SECRET=forkyard-local-secret
GOOGLE_CLIENT_ID=forkyard-local.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=forkyard-local-secret

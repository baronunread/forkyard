{
  // Top level = local development (`bun run dev`): Artifacts is emulated by the
  // LocalArtifacts Durable Object, so no Cloudflare account is needed.
  // `env.production` = the real deployment (`bun run deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forkyard",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/git/*", "/.well-known/*", "/llms.txt", "/AGENTS.md", "/healthz"]
  },
  "vars": {
    "ARTIFACTS_MODE": "local",
    "ARTIFACTS_NAMESPACE": "local",
    "LOCAL_GIT_ORIGIN": "http://localhost:8787",
    "FORK_TTL_HOURS": "24",
    "TOKEN_TTL_SECONDS": "14400",
    // Short settle time so the autopilot is visible in a local demo (default 15 s).
    "AUTOPILOT_QUIET_MS": "4000",
    // Local dev only. Sign-in runs against emulate.dev (`bun run dev` starts it with
    // emulate.config.yaml), so these are emulator credentials, not real ones.
    "FORKYARD_DEV": "true",
    "BETTER_AUTH_SECRET": "local-dev-secret-not-for-production-0123456789",
    "EMULATE_GITHUB_URL": "http://localhost:4001",
    "EMULATE_GOOGLE_URL": "http://localhost:4002",
    "GITHUB_CLIENT_ID": "forkyard-local",
    "GITHUB_CLIENT_SECRET": "forkyard-local-secret",
    "GOOGLE_CLIENT_ID": "forkyard-local.apps.googleusercontent.com",
    "GOOGLE_CLIENT_SECRET": "forkyard-local-secret"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "forkyard", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "YARD", "class_name": "Yard" },
      { "name": "ARTIFACTS_EMULATOR", "class_name": "LocalArtifacts" },
      { "name": "PI_AGENT", "class_name": "PiAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Yard", "LocalArtifacts"] },
    { "tag": "v2", "new_sqlite_classes": ["PiAgent"] }
  ],
  "queues": {
    "producers": [{ "binding": "ARTIFACT_EVENTS", "queue": "forkyard-artifact-events" }],
    // Small batches, short wait: a lone push is delivered within the timeout, and a swarm's
    // bursts arrive in batches the consumer routes concurrently.
    "consumers": [{ "queue": "forkyard-artifact-events", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 5 }]
  },
  "workflows": [{ "name": "forkyard-review", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }],
  "triggers": { "crons": ["17 * * * *"] },

  "env": {
    "production": {
      "name": "forkyard",
      "vars": {
        "ARTIFACTS_MODE": "remote",
        "ARTIFACTS_NAMESPACE": "forkyard",
        "LOCAL_GIT_ORIGIN": "",
        "FORK_TTL_HOURS": "24",
        "TOKEN_TTL_SECONDS": "14400",
        "REVIEW_MODEL": "@cf/moonshotai/kimi-k2.7-code",
        "PUBLIC_ORIGIN": "https://forkyard.baronunreadts.workers.dev",
        // Hard limits (src/limits.ts). Workers Paid has no spend cap, so these are it.
        // FORKYARD_PAUSED="true" (redeploy or dashboard var) stops new work at once.
        "FORKYARD_PAUSED": "false",
        "LIMIT_YARDS_PER_ACCOUNT": "3",
        "LIMIT_TASKS_PER_ACCOUNT_PER_DAY": "20",
        "LIMIT_AGENTS_PER_TASK": "5",
        "LIMIT_LIVE_FORKS": "50",
        "LIMIT_AGENT_TURNS": "40",
        "LIMIT_WORKERS_AI_PER_DAY": "200"
        // Secrets (wrangler secret put --env production):
        //   BETTER_AUTH_SECRET                       signs sessions and OAuth state (openssl rand -base64 32)
        //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET   GitHub sign-in (callback: <origin>/api/auth/callback/github)
        //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET   Google sign-in (callback: <origin>/api/auth/callback/google)
        //   FORKYARD_ADMIN_KEY                       operator key for scripts and benchmarks
        //   K2_API_TOKEN                             only for the K2 spike consumer
      },
      "artifacts": [
        { "binding": "ARTIFACTS", "namespace": "forkyard" }
        // EU yards: create an EU-jurisdiction namespace and uncomment.
        // { "binding": "ARTIFACTS_EU", "namespace": "forkyard-eu" }
      ],
      "ai": { "binding": "AI" },
      "d1_databases": [
        { "binding": "DB", "database_name": "forkyard", "database_id": "4b3fcbf6-77fc-4ffd-aea6-a675cba9f8eb", "migrations_dir": "migrations" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "YARD", "class_name": "Yard" },
          { "name": "ARTIFACTS_EMULATOR", "class_name": "LocalArtifacts" },
          { "name": "PI_AGENT", "class_name": "PiAgent" }
        ]
      },
      "queues": {
        "producers": [{ "binding": "ARTIFACT_EVENTS", "queue": "forkyard-artifact-events" }],
        "consumers": [{ "queue": "forkyard-artifact-events", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 10 }]
      },
      "workflows": [{ "name": "forkyard-review", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }],
      "triggers": { "crons": ["17 * * * *"] }
      // K2 spike (see docs/decisions/events.md): create a stream and uncomment.
      // "k2": [{ "binding": "EVENTS_K2", "stream": "<STREAM_ID>" }],
      // plus vars K2_STREAM_ID and K2_SUBSCRIPTION_ID.
    }
  }
}

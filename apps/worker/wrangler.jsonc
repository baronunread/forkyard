{
  // Top level = local development (`pnpm dev`): Artifacts is emulated by the
  // LocalArtifacts Durable Object, so no Cloudflare account is needed.
  // `env.production` = the real deployment (`pnpm deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forkyard",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/git/*", "/.well-known/*", "/llms.txt", "/AGENTS.md", "/healthz"]
  },
  "vars": {
    "ARTIFACTS_MODE": "local",
    "ARTIFACTS_NAMESPACE": "local",
    "LOCAL_GIT_ORIGIN": "http://localhost:8787",
    "FORK_TTL_HOURS": "24",
    "TOKEN_TTL_SECONDS": "14400",
    // Local dev only. Sign-in runs against emulate.dev (`pnpm dev` starts it with
    // emulate.config.yaml), so these are emulator credentials, not real ones.
    "FORKYARD_DEV": "true",
    "BETTER_AUTH_SECRET": "local-dev-secret-not-for-production-0123456789",
    "EMULATE_GITHUB_URL": "http://localhost:4001",
    "EMULATE_GOOGLE_URL": "http://localhost:4002",
    "GITHUB_CLIENT_ID": "forkyard-local",
    "GITHUB_CLIENT_SECRET": "forkyard-local-secret",
    "GOOGLE_CLIENT_ID": "forkyard-local.apps.googleusercontent.com",
    "GOOGLE_CLIENT_SECRET": "forkyard-local-secret"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "forkyard", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "YARD", "class_name": "Yard" },
      { "name": "ARTIFACTS_EMULATOR", "class_name": "LocalArtifacts" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Yard", "LocalArtifacts"] }],
  "queues": {
    "producers": [{ "binding": "ARTIFACT_EVENTS", "queue": "forkyard-artifact-events" }],
    // Batch size 1: a push is delivered as soon as it arrives (live path latency).
    "consumers": [{ "queue": "forkyard-artifact-events", "max_batch_size": 1, "max_retries": 5 }]
  },
  "workflows": [{ "name": "forkyard-review", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }],
  "triggers": { "crons": ["17 * * * *"] },

  "env": {
    "production": {
      "name": "forkyard",
      "vars": {
        "ARTIFACTS_MODE": "remote",
        "ARTIFACTS_NAMESPACE": "forkyard",
        "LOCAL_GIT_ORIGIN": "",
        "FORK_TTL_HOURS": "24",
        "TOKEN_TTL_SECONDS": "14400",
        "REVIEW_MODEL": "@cf/moonshotai/kimi-k2.7-code",
        "PUBLIC_ORIGIN": "https://forkyard.example.com"
        // Secrets (wrangler secret put --env production):
        //   BETTER_AUTH_SECRET                       signs sessions and OAuth state (openssl rand -base64 32)
        //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET   GitHub sign-in (callback: <origin>/api/auth/callback/github)
        //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET   Google sign-in (callback: <origin>/api/auth/callback/google)
        //   FORKYARD_ADMIN_KEY                       operator key for scripts and benchmarks
        //   K2_API_TOKEN                             only for the K2 spike consumer
      },
      "artifacts": [
        { "binding": "ARTIFACTS", "namespace": "forkyard" }
        // EU yards: create an EU-jurisdiction namespace and uncomment.
        // { "binding": "ARTIFACTS_EU", "namespace": "forkyard-eu" }
      ],
      "ai": { "binding": "AI" },
      "d1_databases": [
        { "binding": "DB", "database_name": "forkyard", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "YARD", "class_name": "Yard" },
          { "name": "ARTIFACTS_EMULATOR", "class_name": "LocalArtifacts" }
        ]
      },
      "queues": {
        "producers": [{ "binding": "ARTIFACT_EVENTS", "queue": "forkyard-artifact-events" }],
        "consumers": [{ "queue": "forkyard-artifact-events", "max_batch_size": 1, "max_retries": 5 }]
      },
      "workflows": [{ "name": "forkyard-review", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }],
      "triggers": { "crons": ["17 * * * *"] }
      // K2 spike (see docs/decisions/events.md): create a stream and uncomment.
      // "k2": [{ "binding": "EVENTS_K2", "stream": "<STREAM_ID>" }],
      // plus vars K2_STREAM_ID and K2_SUBSCRIPTION_ID.
    }
  }
}
